# Bot token from https://discord.com/developers/applications (never commit the real one)
DISCORD_TOKEN=
# Where settings and logs are kept
DATA_DIR=./data
# Optional with the wizard (it signs you in with a one-time link), required in Docker
GUI_PASSWORD=
GUI_PORT=48731
# Docker only: GUI_HOST=0.0.0.0 (docker-compose.yml already sets it) and GUI_ALLOWED_HOSTS=my.proxy.example:443 if you use a reverse proxy
