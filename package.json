{
  "name": "warden",
  "version": "0.1.0-beta",
  "description": "Self-hosted, opt-in Discord moderation bot: word filter, spam, raid protection and an admin guard, with a local control panel.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "install-cli": "node bin/warden.js --install",
    "setup": "node bin/warden.js --setup",
    "doctor": "node bin/warden.js --doctor",
    "bench:final": "tsx bench/validate-final.ts",
    "bench:rebuild": "python3 bench/build-final.py"
  },
  "dependencies": {
    "bad-words": "^4.1.5",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "obscenity": "0.4.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "bin": {
    "warden": "bin/warden.js"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "moderation",
    "automod",
    "anti-raid",
    "self-hosted",
    "typescript"
  ],
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mttcn83/warden.git"
  },
  "homepage": "https://github.com/mttcn83/warden#readme",
  "bugs": {
    "url": "https://github.com/mttcn83/warden/issues"
  }
}
